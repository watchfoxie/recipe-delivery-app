{
  "name": "@recipe-delivery-app/web",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "serve": {
        "continuous": true,
        "executor": "@nx/next:server",
        "defaultConfiguration": "development",
        "options": {
          "buildTarget": "@recipe-delivery-app/web:build",
          "dev": true,
          "port": 3000
        },
        "configurations": {
          "development": {
            "dev": true,
            "buildTarget": "@recipe-delivery-app/web:build",
            "port": 3000
          },
          "production": {
            "dev": false,
            "buildTarget": "@recipe-delivery-app/web:build:production",
            "port": 3000
          }
        }
      }
    },
    "tags": [
      "type:web",
      "scope:core"
    ]
  },
  "dependencies": {
    "next": "~15.2.4",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  }
}
