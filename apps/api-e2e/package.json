{
  "name": "@recipe-delivery-app/api-e2e",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "projectType": "application",
    "type": "e2e",
    "implicitDependencies": [
      "@recipe-delivery-app/api"
    ],
    "targets": {
      "e2e": {
        "executor": "@nx/jest:jest",
        "outputs": [
          "{projectRoot}/test-output/jest/coverage"
        ],
        "options": {
          "jestConfig": "apps/api-e2e/jest.config.ts",
          "passWithNoTests": true
        },
        "dependsOn": []
      },
      "e2e:ci": {
        "executor": "nx:noop",
        "dependsOn": [
          "e2e"
        ],
        "cache": false
      }
    }
  }
}
